# Database
DB_URL=jdbc:postgresql://localhost:5432/knowledge_assistant
DB_USERNAME=knowledge
DB_PASSWORD=knowledge

# Security
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MINUTES=60

# AI providers
# Required for document embeddings and Gemini generation.
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Required for generation fallback.
HF_TOKEN=replace-with-your-huggingface-token

# Models
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_GENERATION_MODEL=gemini-3.8-flash
HF_GENERATION_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
