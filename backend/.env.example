# Database
DB_URL=jdbc:postgresql://localhost:5432/knowledge_assistant
DB_USERNAME=knowledge
DB_PASSWORD=knowledge

# Security
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MINUTES=60

# AI Providers
# xAI Grok Generation (primary generation provider)
GROK_API_KEY=replace-with-your-xai-grok-api-key
GROK_MODEL=grok-2-latest
GROK_BASE_URL=https://api.x.ai/v1

# Hugging Face (generation fallback provider)
HF_TOKEN=replace-with-your-huggingface-token
HF_GENERATION_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Google Generative AI Embeddings (primary embedding provider: 768 dims matching pgvector schema)
GOOGLE_API_KEY=replace-with-your-google-gemini-api-key
EMBEDDING_MODEL=google-embedding-2
EMBEDDING_DIMENSIONS=768

# Sentence Transformers Embeddings (local fallback)
EMBEDDING_SERVICE_URL=http://127.0.0.1:8001

# Cross-Encoder Reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval Pipeline Settings
RETRIEVAL_MINIMUM_SIMILARITY=0.40
RETRIEVAL_DENSE_CANDIDATES=15
RETRIEVAL_SPARSE_CANDIDATES=15
RETRIEVAL_FUSION_CANDIDATES=12
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_CONTEXT_TOKENS=3500
